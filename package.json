{
  "name": "workspace-saas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
